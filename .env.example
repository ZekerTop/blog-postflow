# 全部可选：登录密码、GitHub Token、AI Key、博客都可以在网页「设置」里填（存 SQLite）。环境变量只作兜底。
# 复制为 .env（已在 .gitignore），真实值永不入库。

# 登录密码哈希（不填则首次打开页面时用初始化码设置）：python -m app.hashpw 生成
POSTFLOW_PASSWORD_HASH=
# 会话签名密钥（不填自动生成，存在数据库旁边）
POSTFLOW_SESSION_SECRET=
# fine-grained PAT：只授权博客源码仓库，Contents 读写 + Actions 只读
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 本地 http 调试时设 false；线上 HTTPS 保持 true
POSTFLOW_COOKIE_SECURE=true
# 可选
# POSTFLOW_BLOGS_FILE=/path/to/blogs.yml
# POSTFLOW_DB_FILE=/path/to/postflow.db
# POSTFLOW_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12   # 只信任这些反代传来的 X-Real-IP
# POSTFLOW_ALLOW_PRIVATE_AI=false                              # 允许 AI 接口地址是内网 / 本机（如本地 Ollama 中转）
